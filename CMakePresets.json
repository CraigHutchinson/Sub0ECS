{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
        },
        {
            "name": "default",
            "inherits": "base",
            "displayName": "Release: tests + benchmarks (on Windows, run from a VS developer prompt)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SUB0ECS_BUILD_TESTING": "ON",
                "SUB0ECS_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug: tests only",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SUB0ECS_BUILD_TESTING": "ON",
                "SUB0ECS_BUILD_BENCHMARKS": "OFF"
            }
        },
        {
            "name": "sanitize",
            "inherits": "base",
            "displayName": "Debug + sanitizers (ASan/UBSan; ASan on MSVC): tests only",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SUB0ECS_BUILD_TESTING": "ON",
                "SUB0ECS_BUILD_BENCHMARKS": "OFF",
                "SUB0ECS_SANITIZE": "ON"
            }
        },
        {
            "name": "bench-native",
            "inherits": "base",
            "displayName": "Benchmarks tuned for THIS machine (-march=native; /arch:AVX2 on MSVC)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SUB0ECS_BUILD_TESTING": "ON",
                "SUB0ECS_BUILD_BENCHMARKS": "ON",
                "SUB0ECS_NATIVE": "ON"
            }
        },
        {
            "name": "bench-portable",
            "inherits": "bench-native",
            "displayName": "Benchmarks without host tuning (cross-machine comparable)",
            "cacheVariables": { "SUB0ECS_NATIVE": "OFF" }
        },
        {
            "name": "ci-msvc",
            "displayName": "CI: MSVC via the Visual Studio generator (no developer prompt needed)",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolset": { "value": "host=x64", "strategy": "set" },
            "cacheVariables": {
                "SUB0ECS_BUILD_TESTING": "ON",
                "SUB0ECS_BUILD_BENCHMARKS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "debug", "configurePreset": "debug" },
        { "name": "sanitize", "configurePreset": "sanitize" },
        { "name": "bench-native", "configurePreset": "bench-native" },
        { "name": "bench-portable", "configurePreset": "bench-portable" },
        { "name": "ci-msvc", "configurePreset": "ci-msvc", "configuration": "Release" }
    ],
    "testPresets": [
        { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
        { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
        { "name": "ci-msvc", "configurePreset": "ci-msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
    ]
}
